calculate_lip_usage <- function(qf, i_lip, i_tc, contrasts, fcol_lip = "Protein.Group", fcol_tc = "Protein.Group",  satterthwaite = FALSE)
{
match_precursor_to_protein_FC <- match(rowData(qf[[i_lip]])[[fcol_lip]],
rowData(qf[[i_tc]])[[fcol_tc]]) #1.
for (contrast in contrasts)
{
results_tc <- rowData(qf[[i_tc]])[[contrast]] #2.1
colnames(results_tc) <- results_tc |>
colnames() |>
paste0("_tc")
rowData(qf[[i_lip]])[[contrast]] <- cbind(
rowData(qf[[i_lip]])[[contrast]],
results_tc[match_precursor_to_protein_FC,]) |> #2.2
mutate(
usage = logFC - logFC_tc, #2.3
se_usage = sqrt(se^2 + se_tc^2),
t_usage = usage /se_usage,
df_usage = if (satterthwaite) (se^2 + se_tc^2)^2/(se^4/df + se_tc^4/df_tc) else df,
pval_usage = pt(abs(t_usage), df_usage, lower.tail = FALSE)*2,
adjPval_usage = p.adjust(pval_usage, method = "fdr")
)
}
return(qf)
}
qf <- calculate_lip_usage(qf, i_lip = "precursors_lip_norm", i_tc = "proteins_tc", contrasts = colnames(L))
pep_char <- function(table, prot_seq="Protein.Sequence", pep_seq="Stripped.Sequence")
{
table <- table |>
mutate(missed_cleavages = get(pep_seq) |>
str_count("[RK](?!(P|$))"), #1.
total_repeats = str_count(get(prot_seq), get(pep_seq)), #2.
tmp = str_locate(Protein.Sequence, Stripped.Sequence),
start = tmp[,1],
end = tmp[,2], #3.
pep_type = ifelse(
(total_repeats > 1) | is.na(total_repeats),
"Ambiguous",
classify_trypticity(
peptide = Stripped.Sequence,
protein = Protein.Sequence,
start_pos = start)), #4.
AA_last = str_sub(Stripped.Sequence, -1, -1) #5.
) |>
select(-tmp)
}
calculate_coverage <- function(start, end, protein_length) {
require(IRanges)
#Checks
if (is.na(protein_length)) return(NA)
startEnd <- cbind(start,end) |> na.omit()
if (nrow(startEnd) <1) return(NA)
covered <- IRanges(startEnd[,1], startEnd[,2]) |>
coverage() |>
as.logical() |>
sum()
return(covered/protein_length)
}
classify_trypticity <- function(peptide, protein, start_pos) {
pep_len <- sapply(peptide, nchar)
end_pos <- start_pos + pep_len - 1
# Get surrounding amino acids
AA_before <- ifelse(start_pos > 1,
substr(protein, start_pos - 1, start_pos - 1),
"")
AA_after <- ifelse(end_pos < nchar(protein),
substr(protein, end_pos + 1, end_pos + 1),
"")
AA_first <- substr(peptide, 1, 1)
AA_last  <- substr(peptide, pep_len, pep_len)
# Classification
ambiguous <- is.na(protein) | is.na(start_pos)
internal_tryptic <- (AA_before %in% c("K", "R")) & (AA_last %in% c("K", "R")) #internal tryptic peptides
c_tryptic <- (AA_before %in% c("K", "R")) & (AA_after=="") #C-terminal tryptic peptides
n_tryptic <- ((AA_before == "") | (AA_before == "M" & start_pos==2)) & (AA_last %in% c("K", "R")) #N-terminal tryptic peptides
semi_tryptic <- (AA_before %in% c("K", "R")) | (AA_last %in% c("K", "R"))
return(
ifelse(ambiguous,
"Ambiguous",
ifelse(n_tryptic | c_tryptic | internal_tryptic,
"Tryptic",
ifelse(semi_tryptic,
"Semi-Tryptic",
"Non-Tryptic")
)
)
)
}
results_lip <- results_lip |>
left_join(mapping, by = join_by(Protein.Group == Accession)) |>
pep_char()
